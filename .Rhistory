true_tau3_x0 <- pickK(true_tau3, K, Nshow)
obs_tau3_x0  <- pickK(obs_tau3,  K, Nshow)
corr_tau3_x0 <- mc$samples  # already at x0
# --------- Plots ----------
df_den <- rbind(
data.frame(val=obs_tau3_x0,  type="Observed τ3  | X≈x0 (K-weighted)"),
data.frame(val=true_tau3_x0, type="True latent τ3* | X≈x0 (K-weighted)"),
data.frame(val=corr_tau3_x0, type="SIMEX-corrected τ3* | X = x0")
)
p_den <- ggplot(df_den, aes(val, fill=type)) +
geom_density(alpha=.35) +
labs(title="Kernel-matched comparison at X = x0",
x=expression(tau[3]), y="Density", fill=NULL) +
theme_minimal(base_size=12)
med_tbl <- aggregate(val ~ type, df_den, median)
p_den <- p_den + geom_vline(data=med_tbl, aes(xintercept=val, color=type),
linewidth=.7, linetype=2) +
scale_color_discrete(guide = "none")
# QQs (corrected vs true; observed vs true), both kernel-matched
mkqq <- function(a,b) {
probs <- seq(0.01,0.99,by=0.01)
data.frame(x=quantile(a,probs), y=quantile(b,probs))
}
qq_corr <- mkqq(true_tau3_x0, corr_tau3_x0)
qq_obs  <- mkqq(true_tau3_x0, obs_tau3_x0)
p_qq1 <- ggplot(qq_corr, aes(x,y)) +
geom_abline(slope=1, intercept=0, linetype=2, linewidth=.6) +
geom_point(size=1.6, alpha=.75) +
labs(title="QQ: SIMEX-corrected vs True (kernel-matched)",
x=expression("True latent  "*tau[3]^"*"), y=expression(hat(tau)[3]^"*"))
p_qq2 <- ggplot(qq_obs, aes(x,y)) +
geom_abline(slope=1, intercept=0, linetype=2, linewidth=.6) +
geom_point(size=1.6, alpha=.75, color="#888888") +
labs(title="QQ: Observed vs True (kernel-matched)",
x=expression("True latent  "*tau[3]^"*"), y=expression(tau[3]))
grid.arrange(p_den, arrangeGrob(p_qq1, p_qq2, ncol=2), nrow=2)
# Numbers to quote
summ <- function(x) c(med=median(x), iqr=IQR(x))
print(round(rbind(
"Observed τ3 | X≈x0 (K)"   = summ(obs_tau3_x0),
"True latent τ3* | X≈x0 (K)" = summ(true_tau3_x0),
"SIMEX τ3* | X=x0"           = summ(corr_tau3_x0)
), 2))
#################################
# SIMEX SIMULATION (FULL, ROBUST)
#################################
rm(list=ls()); set.seed(2025)
library(quantreg)
# -------- 0) Settings --------
n <- 5000
t_grid <- c(5,10,20,40)                  # t0,t1,t2,t3
t_len  <- rep(4, n)                       # subject-specific support length 𝔱_i
u_i    <- t_len/2                         # location shift (NOT used inside SIMEX)
# -------- 1) Observed data (anchored at t0=0) --------
X1 <- rnorm(n); X2 <- rnorm(n)
beta <- c(-0.2, 0.1)
tau3 <- 30 + beta[1]*X1 + beta[2]*X2 + rnorm(n, 0, 5)
tau_obs <- cbind(
t0 = 0,
t1 = tau3 * (t_grid[2]/t_grid[4]),
t2 = tau3 * (t_grid[3]/t_grid[4]),
t3 = tau3
)
D_obs <- tau_obs[, "t3"] - tau_obs       # D(tk) = t3 - tk
# -------- helpers --------
draw_eta <- function(n, tl) runif(n, -tl/2, tl/2)     # mean-zero, subject-specific width
ker_w    <- function(X, x0, h) {
Z <- sweep(X, 2, x0, "-") / matrix(h, nrow(X), ncol(X), byrow=TRUE)
K <- exp(-0.5 * rowSums(Z^2)); K / sum(K)
}
safe_bandwidth <- function(X){
s <- apply(X, 2, sd)
s[s < 1e-6] <- 1e-6
1.06 * s / (nrow(X)^(1/(4+ncol(X))))
}
# -------- 2) Step-1: SIMEX CDF F_{tau*}(t1 | X=x0) --------
simex_cdf_t1 <- function(tau1, X, x0, t_eval,
lambdas=c(0.5,1,1.5,2), B=200, t_len) {
X <- as.matrix(X); h <- safe_bandwidth(X); K <- ker_w(X, x0, h)
P <- matrix(NA_real_, length(t_eval), length(lambdas))
for (j in seq_along(lambdas)) {
lam <- lambdas[j]; acc <- numeric(length(t_eval))
for (b in 1:B) {
tau_lam <- tau1 + sqrt(lam) * draw_eta(length(tau1), t_len)
acc <- acc + sapply(t_eval, function(t) sum(K * (tau_lam <= t)))
}
P[, j] <- acc / B
}
# quadratic extrapolation to λ = -1 + rearrangement
F_hat <- sapply(seq_along(t_eval), function(i){
fit <- lm(P[i,] ~ lambdas + I(lambdas^2))
sum(coef(fit) * c(1, -1, 1))
})
ord <- order(t_eval); F_hat <- pmin(1, pmax(0, F_hat)); F_hat[ord] <- cummax(F_hat[ord])
# add endpoints if missing (for safe inverse-CDF)
t_use <- t_eval[ord]; F_use <- F_hat[ord]
if (min(F_use) > 0) { t_use <- c(min(t_use), t_use); F_use <- c(0, F_use) }
if (max(F_use) < 1) { t_use <- c(t_use, max(t_use)); F_use <- c(F_use, 1) }
list(t=t_use, F=F_use)
}
# -------- 3) Step-2: Quantile-SIMEX for D*(t1) | X, tau* --------
simex_rq_Dt1 <- function(D_t1, tau1, X,
lambdas = c(0.5,1,1.5,2), B=150, t_len,
p_grid  = seq(0.1,0.9,0.1)) {
X <- as.matrix(X)
coefs <- array(NA_real_, dim=c(4, length(p_grid), length(lambdas)),
dimnames=list(c("(Intercept)","X1","X2","tau1"),
paste0("p",p_grid), paste0("lam",lambdas)))
for (j in seq_along(lambdas)) {
lam <- lambdas[j]; acc <- matrix(0, 4, length(p_grid))
for (b in 1:B) {
tau1_lam <- tau1 + sqrt(lam) * draw_eta(length(tau1), t_len)
df <- data.frame(D=D_t1, X1=X[,1], X2=X[,2], tau1=tau1_lam)
for (k in seq_along(p_grid)) {
cf <- coef(suppressWarnings(rq(D ~ X1 + X2 + tau1, tau=p_grid[k], data=df)))
v <- setNames(rep(0,4), c("(Intercept)","X1","X2","tau1")); v[names(cf)] <- cf
acc[,k] <- acc[,k] + v
}
}
coefs[,,j] <- acc / B
}
# quadratic extrapolation at λ=-1, per coefficient and p
rq_star <- lapply(seq_along(p_grid), function(k){
est <- setNames(numeric(4), c("(Intercept)","X1","X2","tau1"))
for (r in 1:4){
fit <- lm(coefs[r,k,] ~ lambdas + I(lambdas^2))
est[r] <- sum(coef(fit) * c(1,-1,1))
}
est
})
names(rq_star) <- paste0("p", p_grid)
list(p=p_grid, coefs=rq_star)
}
# --- safer predictor (returns NA if coefficients are non-finite) ---
predict_rq <- function(rq_obj, x0, u, p){
pg <- rq_obj$p
get_cf <- function(p_use) rq_obj$coefs[[paste0("p", p_use)]]
# interpolate coefficients if p not on grid
cf <- if (!p %in% pg) {
j2 <- which(pg >= p)[1]; j1 <- j2 - 1
if (is.na(j1) || is.na(j2)) return(NA_real_)
w  <- (p - pg[j1])/(pg[j2]-pg[j1])
c1 <- get_cf(pg[j1]); c2 <- get_cf(pg[j2])
if (any(!is.finite(c1)) || any(!is.finite(c2))) return(NA_real_)
(1-w)*c1 + w*c2
} else {
cf0 <- get_cf(p)
if (any(!is.finite(cf0))) return(NA_real_)
cf0
}
val <- unname(cf["(Intercept)"] + cf["X1"]*x0[1] + cf["X2"]*x0[2] + cf["tau1"]*u)
if (!is.finite(val)) NA_real_ else val
}
# --- build a finite, monotone quantile curve q(p | u) on pp ---
make_quantile_curve <- function(rq_obj, x0, u, pp, D_fallback_median){
qv_raw <- sapply(pp, function(p) suppressWarnings(predict_rq(rq_obj, x0, u, p)))
ok     <- is.finite(qv_raw)
if (sum(ok) >= 2) {
qv_filled <- approx(x=pp[ok], y=qv_raw[ok], xout=pp, rule=2, ties="ordered")$y
} else {
qv_filled <- rep(D_fallback_median, length(pp))  # conservative fallback
}
cummax(qv_filled)                                   # enforce monotone in p
}
# --- 4) Step-3: Robust MC convolution → τ*(t3) | X=x0 ---
mc_tau3 <- function(F1, rqD, x0, D_ref, N=4000, add_back=FALSE, u_loc=NULL){
# safe inverse-CDF for U ~ F_{tau*}(t1|X=x0)
inv_cdf <- function(F1, u){
u <- pmin(1, pmax(0, u))
approx(x=F1$F, y=F1$t, xout=u, rule=2, ties="ordered")$y
}
U <- inv_cdf(F1, runif(N))
# V via inverse-quantiles from rq model of D*
pp <- seq(0.01, 0.99, by=0.01)
D_med <- stats::median(D_ref, na.rm=TRUE)
V <- vapply(U, function(u){
qv <- make_quantile_curve(rq_obj=rqD, x0=x0, u=u, pp=pp, D_fallback_median=D_med)
approx(x=pp, y=qv, xout=runif(1), rule=2, ties="ordered")$y
}, numeric(1))
W <- U + V
if (add_back) {
if (is.null(u_loc)) stop("Provide u_loc if add_back=TRUE.")
W <- W + u_loc
}
W <- W[is.finite(W)]                               # drop any stragglers
list(
q = function(probs=c(0.25,0.5,0.75)){
if (length(W) < 2) stop("Not enough finite samples in W.")
as.numeric(quantile(W, probs, na.rm=TRUE))
},
samples = W
)
}
# ===============================================
# ===== Run =====
X   <- cbind(X1,X2); x0 <- c(median(X1), median(X2))
tau1 <- tau_obs[,"t1"]; D_t1 <- as.numeric(D_obs[,"t1"])
lambdas <- c(0.25, 0.5, 1, 1.5, 2)
B1 <- 400   # for Step-1
B2 <- 250   # for Step-2
p_grid <- seq(0.05, 0.95, by=0.05)
F1  <- simex_cdf_t1(tau1, X, x0, t_eval = seq(5,25,length.out=120),
lambdas = lambdas, B = B1, t_len = t_len)
rqD <- simex_rq_Dt1(D_t1, tau1, X,
lambdas = lambdas, B = B2, t_len = t_len, p_grid = p_grid)
mc  <- mc_tau3(F1=F1, rqD=rqD, x0=x0, D_ref=D_t1, N=10000, add_back=FALSE)
# Example output: median and IQR of τ*(t3) | X=x0 (anchored frame)
mc$q(c(0.25, 0.5, 0.75))
# ===============================
# VISUALS: observed vs true latent vs SIMEX-corrected (at x0)
# ===============================
library(ggplot2); library(gridExtra)
# --- rebuild the SAME kernel weights K used in Step-1 ---
safe_bandwidth <- function(X){
s <- apply(X, 2, sd); s[s < 1e-6] <- 1e-6
1.06 * s / (nrow(X)^(1/(4+ncol(X))))
}
ker_w <- function(X, x0, h) {
Z <- sweep(X, 2, x0, "-") / matrix(h, nrow(X), ncol(X), byrow=TRUE)
K <- exp(-0.5 * rowSums(Z^2)); K / sum(K)
}
h  <- safe_bandwidth(as.matrix(X))
K  <- ker_w(as.matrix(X), x0, h)
# --- build latent truth ONCE for evaluation only ---
set.seed(2025 + 1)
eta_true <- runif(n, -t_len/2, t_len/2)
eps_true <- (t_len/2) + eta_true
tau_star <- sweep(tau_obs, 1, eps_true, "+")
true_tau3 <- tau_star[,"t3"]
obs_tau3  <- tau_obs[,"t3"]
# --- kernel-weighted draws around x0 (same conditioning as SIMEX) ---
Nshow <- 10000
pickK <- function(x, K, N) sample(x, size=N, replace=TRUE, prob=K)
true_tau3_x0 <- pickK(true_tau3, K, Nshow)
obs_tau3_x0  <- pickK(obs_tau3,  K, Nshow)
corr_tau3_x0 <- mc$samples  # already at x0
# --------- Plots ----------
df_den <- rbind(
data.frame(val=obs_tau3_x0,  type="Observed τ3  | X≈x0 (K-weighted)"),
data.frame(val=true_tau3_x0, type="True latent τ3* | X≈x0 (K-weighted)"),
data.frame(val=corr_tau3_x0, type="SIMEX-corrected τ3* | X = x0")
)
p_den <- ggplot(df_den, aes(val, fill=type)) +
geom_density(alpha=.35) +
labs(title="Kernel-matched comparison at X = x0",
x=expression(tau[3]), y="Density", fill=NULL) +
theme_minimal(base_size=12)
med_tbl <- aggregate(val ~ type, df_den, median)
p_den <- p_den + geom_vline(data=med_tbl, aes(xintercept=val, color=type),
linewidth=.7, linetype=2) +
scale_color_discrete(guide = "none")
# QQs (corrected vs true; observed vs true), both kernel-matched
mkqq <- function(a,b) {
probs <- seq(0.01,0.99,by=0.01)
data.frame(x=quantile(a,probs), y=quantile(b,probs))
}
qq_corr <- mkqq(true_tau3_x0, corr_tau3_x0)
qq_obs  <- mkqq(true_tau3_x0, obs_tau3_x0)
p_qq1 <- ggplot(qq_corr, aes(x,y)) +
geom_abline(slope=1, intercept=0, linetype=2, linewidth=.6) +
geom_point(size=1.6, alpha=.75) +
labs(title="QQ: SIMEX-corrected vs True (kernel-matched)",
x=expression("True latent  "*tau[3]^"*"), y=expression(hat(tau)[3]^"*"))
p_qq2 <- ggplot(qq_obs, aes(x,y)) +
geom_abline(slope=1, intercept=0, linetype=2, linewidth=.6) +
geom_point(size=1.6, alpha=.75, color="#888888") +
labs(title="QQ: Observed vs True (kernel-matched)",
x=expression("True latent  "*tau[3]^"*"), y=expression(tau[3]))
grid.arrange(p_den, arrangeGrob(p_qq1, p_qq2, ncol=2), nrow=2)
# Numbers to quote
summ <- function(x) c(med=median(x), iqr=IQR(x))
print(round(rbind(
"Observed τ3 | X≈x0 (K)"   = summ(obs_tau3_x0),
"True latent τ3* | X≈x0 (K)" = summ(true_tau3_x0),
"SIMEX τ3* | X=x0"           = summ(corr_tau3_x0)
), 2))
##############################################
# SIMEX with multiple time-points (full code)
##############################################
rm(list=ls()); set.seed(2025)
suppressPackageStartupMessages({
library(quantreg)
if (!requireNamespace("ggplot2", quietly=TRUE)) install.packages("ggplot2")
if (!requireNamespace("gridExtra", quietly=TRUE)) install.packages("gridExtra")
})
library(ggplot2); library(gridExtra)
# ========= 0) Settings =========
n        <- 800                          # sample size (a bit larger for smoothness)
t_grid   <- seq(5, 40, length.out = 9)   # t0..t8 (7 interior points -> smoother CDFs)
L        <- length(t_grid)
t_len    <- rep(6, n)                    # subject-specific error support 𝔱_i (bigger = harder)
u_i      <- t_len/2                      # deterministic location (not used inside SIMEX)
# SIMEX knobs (sturdier)
lambdas  <- c(0.25, 0.5, 1, 1.5, 2)
B1       <- 400                          # reps for Step-1
B2       <- 250                          # reps for Step-2
p_grid   <- seq(0.05, 0.95, by=0.05)     # rq quantile grid
Nmc      <- 8000                         # MC draws per time-point for smooth curves
# ========= 1) Observed data (anchored at t0=0) =========
X1 <- rnorm(n); X2 <- rnorm(n)
beta <- c(-0.25, 0.12)
tauL <- 30 + beta[1]*X1 + beta[2]*X2 + rnorm(n, 0, 5)   # final observed time (t_L)
# linear interpolation to interior times:
tau_obs <- sapply(t_grid, function(tk) tauL * (tk / max(t_grid)))
tau_obs[,1] <- 0                                          # anchor at t0
colnames(tau_obs) <- paste0("t", 0:(L-1))
D_obs <- tau_obs[, L] - tau_obs                           # D(t_k) = t_L - t_k
# ========= helpers =========
draw_eta <- function(n, tl) runif(n, -tl/2, tl/2)         # mean-zero, subj-specific width
safe_bandwidth <- function(X){
X <- as.matrix(X); s <- apply(X, 2, sd); s[s < 1e-6] <- 1e-6
1.06 * s / (nrow(X)^(1/(4+ncol(X))))
}
ker_w <- function(X, x0, h){
Z <- sweep(X, 2, x0, "-") / matrix(h, nrow(X), ncol(X), byrow=TRUE)
K <- exp(-0.5 * rowSums(Z^2)); K / sum(K)
}
# ========= 2) Step-1: SIMEX CDF F_{tau*}(t_k | X=x0) =========
simex_cdf_tk <- function(tau_k, X, x0, t_eval, lambdas, B, t_len){
X <- as.matrix(X); h <- safe_bandwidth(X); K <- ker_w(X, x0, h)
P <- matrix(NA_real_, length(t_eval), length(lambdas))
for (j in seq_along(lambdas)) {
lam <- lambdas[j]; acc <- numeric(length(t_eval))
for (b in 1:B) {
tau_lam <- tau_k + sqrt(lam) * draw_eta(length(tau_k), t_len)
acc <- acc + sapply(t_eval, function(t) sum(K * (tau_lam <= t)))
}
P[, j] <- acc / B
}
F_hat <- sapply(seq_along(t_eval), function(i){
fit <- lm(P[i,] ~ lambdas + I(lambdas^2))
sum(coef(fit) * c(1, -1, 1))
})
ord <- order(t_eval); F_hat <- pmin(1, pmax(0, F_hat)); F_hat[ord] <- cummax(F_hat[ord])
t_use <- t_eval[ord]; F_use <- F_hat[ord]
if (min(F_use) > 0) { t_use <- c(min(t_use), t_use); F_use <- c(0, F_use) }
if (max(F_use) < 1) { t_use <- c(t_use, max(t_use)); F_use <- c(F_use, 1) }
list(t=t_use, F=F_use, K=K, h=h)   # return K,h for fair comparisons
}
# ========= 3) Step-2: Quantile-SIMEX for D*(t_k) | X, tau* =========
simex_rq_Dtk <- function(D_k, tau_k, X, lambdas, B, t_len, p_grid){
X <- as.matrix(X)
coefs <- array(NA_real_, dim=c(4, length(p_grid), length(lambdas)),
dimnames=list(c("(Intercept)","X1","X2","tauk"),
paste0("p",p_grid), paste0("lam",lambdas)))
for (j in seq_along(lambdas)) {
lam <- lambdas[j]; acc <- matrix(0, 4, length(p_grid))
for (b in 1:B) {
tau_lam <- tau_k + sqrt(lam) * draw_eta(length(tau_k), t_len)
df <- data.frame(D=D_k, X1=X[,1], X2=X[,2], tauk=tau_lam)
for (k in seq_along(p_grid)) {
cf <- coef(suppressWarnings(rq(D ~ X1 + X2 + tauk, tau=p_grid[k], data=df)))
v <- setNames(rep(0,4), c("(Intercept)","X1","X2","tauk")); v[names(cf)] <- cf
acc[,k] <- acc[,k] + v
}
}
coefs[,,j] <- acc / B
}
rq_star <- lapply(seq_along(p_grid), function(k){
est <- setNames(numeric(4), c("(Intercept)","X1","X2","tauk"))
for (r in 1:4){
fit <- lm(coefs[r,k,] ~ lambdas + I(lambdas^2))
est[r] <- sum(coef(fit) * c(1,-1,1))
}
est
})
names(rq_star) <- paste0("p", p_grid)
list(p=p_grid, coefs=rq_star)
}
predict_rq <- function(rq_obj, x0, u, p){
pg <- rq_obj$p; get_cf <- function(pu) rq_obj$coefs[[paste0("p",pu)]]
cf <- if (!p %in% pg) {
j2 <- which(pg >= p)[1]; j1 <- j2 - 1
if (is.na(j1) || is.na(j2)) return(NA_real_)
w <- (p - pg[j1])/(pg[j2]-pg[j1]); c1 <- get_cf(pg[j1]); c2 <- get_cf(pg[j2])
if (any(!is.finite(c1)) || any(!is.finite(c2))) return(NA_real_)
(1-w)*c1 + w*c2
} else { cf0 <- get_cf(p); if (any(!is.finite(cf0))) return(NA_real_) else cf0 }
val <- unname(cf["(Intercept)"] + cf["X1"]*x0[1] + cf["X2"]*x0[2] + cf["tauk"]*u)
if (!is.finite(val)) NA_real_ else val
}
make_quantile_curve <- function(rq_obj, x0, u, pp, D_fallback){
qraw <- sapply(pp, function(p) suppressWarnings(predict_rq(rq_obj, x0, u, p)))
ok   <- is.finite(qraw)
if (sum(ok) >= 2) {
qfill <- approx(x=pp[ok], y=qraw[ok], xout=pp, rule=2, ties="ordered")$y
} else qfill <- rep(D_fallback, length(pp))
cummax(qfill)
}
# ========= 4) Step-3: MC convolution for a given t_k =========
mc_tauL_from_k <- function(Fk, rqk, x0, D_k, Nmc){
inv_cdf <- function(F1, u){
u <- pmin(1, pmax(0, u))
approx(x=F1$F, y=F1$t, xout=u, rule=2, ties="ordered")$y
}
U <- inv_cdf(Fk, runif(Nmc))
pp <- seq(0.01, 0.99, by=0.01)
Dmed <- median(D_k, na.rm=TRUE)
V <- vapply(U, function(u){
qv <- make_quantile_curve(rq_obj=rqk, x0=x0, u=u, pp=pp, D_fallback=Dmed)
approx(x=pp, y=qv, xout=runif(1), rule=2, ties="ordered")$y
}, numeric(1))
U + V
}
# ========= 5) Run pipeline for a SET of time-points and combine =========
X   <- cbind(X1, X2)
x0  <- c(median(X1), median(X2))
t_idx_use <- 2:(L-1)                   # use all interior times t1..t_{L-1}
# containers
samples_by_k <- vector("list", length(t_idx_use))
names(samples_by_k) <- colnames(tau_obs)[t_idx_use]
for (kk in seq_along(t_idx_use)){
k <- t_idx_use[kk]
tau_k <- tau_obs[, k]
D_k   <- as.numeric(D_obs[, k])
Fk  <- simex_cdf_tk(tau_k, X, x0, t_eval = seq(min(tau_k), max(tau_k), length.out=140),
lambdas = lambdas, B = B1, t_len = t_len)
rqk <- simex_rq_Dtk(D_k, tau_k, X,
lambdas = lambdas, B = B2, t_len = t_len, p_grid = p_grid)
samples_by_k[[kk]] <- mc_tauL_from_k(Fk, rqk, x0, D_k, Nmc)
}
# Equal-weight mixture across all t_k estimates (smooth + efficient)
W_mix <- unlist(samples_by_k, use.names = FALSE)
# ========= 6) Build true latent (for evaluation only) and kernel-matched comparisons =========
set.seed(2025 + 1)
eta_true <- runif(n, -t_len/2, t_len/2)
eps_true <- (t_len/2) + eta_true
tau_star <- sweep(tau_obs, 1, eps_true, "+")            # latent process (unobserved)
true_tauL <- tau_star[, L]
obs_tauL  <- tau_obs[, L]
# same kernel weights used in Step-1 (from any k; recompute for clarity)
h  <- safe_bandwidth(as.matrix(X))
K  <- ker_w(as.matrix(X), x0, h)
pickK <- function(x, K, N) sample(x, size=N, replace=TRUE, prob=K)
Nshow <- 12000  # for very smooth empirical curves
true_tauL_x0 <- pickK(true_tauL, K, Nshow)
obs_tauL_x0  <- pickK(obs_tauL,  K, Nshow)
corr_tauL_x0 <- W_mix
# ========= 7) Plots: kernel-matched densities + QQs =========
df_den <- rbind(
data.frame(val=obs_tauL_x0,  type="Observed τ3  | X≈x0 (kernel)"),
data.frame(val=true_tauL_x0, type="True latent τ3* | X≈x0 (kernel)"),
data.frame(val=corr_tauL_x0, type="SIMEX-corrected τ3* | X = x0 (mixture across t_k)")
)
p_den <- ggplot(df_den, aes(val, fill=type)) +
geom_density(alpha=.35) +
labs(title="τ3 distributions at X = x0 (kernel-matched)",
x=expression(tau[3]), y="Density", fill=NULL) +
theme_minimal(base_size=12)
med_tbl <- aggregate(val ~ type, df_den, median)
p_den <- p_den + geom_vline(data=med_tbl, aes(xintercept=val, color=type),
linewidth=.7, linetype=2) +
scale_color_discrete(guide="none")
mkqq <- function(a,b){
probs <- seq(0.01,0.99,by=0.01)
data.frame(x=quantile(a,probs), y=quantile(b,probs))
}
qq_corr <- mkqq(true_tauL_x0, corr_tauL_x0)
qq_obs  <- mkqq(true_tauL_x0, obs_tauL_x0)
p_qq1 <- ggplot(qq_corr, aes(x,y)) +
geom_abline(slope=1, intercept=0, linetype=2, linewidth=.6) +
geom_point(size=1.6, alpha=.75) +
labs(title="QQ: SIMEX-corrected vs True latent (kernel-matched)",
x=expression("True latent  "*tau[3]^"*"),
y=expression(hat(tau)[3]^"*"*"  (mixture)")) +
theme_minimal(base_size=12)
p_qq2 <- ggplot(qq_obs, aes(x,y)) +
geom_abline(slope=1, intercept=0, linetype=2, linewidth=.6) +
geom_point(size=1.6, alpha=.75, color="#888888") +
labs(title="QQ: Observed vs True latent (kernel-matched)",
x=expression("True latent  "*tau[3]^"*"),
y=expression(tau[3])) +
theme_minimal(base_size=12)
grid.arrange(p_den, arrangeGrob(p_qq1, p_qq2, ncol=2), nrow=2)
# ========= 8) Numbers to quote =========
summ <- function(x) c(med=median(x), iqr=IQR(x))
print(round(rbind(
"Observed τ3 | X≈x0 (kernel)"       = summ(obs_tauL_x0),
"True latent τ3* | X≈x0 (kernel)"   = summ(true_tauL_x0),
"SIMEX τ3* (mixture) | X=x0"        = summ(corr_tauL_x0)
), 2))
View(D_obs)
